# ===========================
# Garimpador de Peças — .env
# ===========================

# Backend
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Banco de dados — em dev usa SQLite local automaticamente. Em prod, Postgres Neon.
DATABASE_URL=

# Token de acesso ao app (32 bytes hex)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_KEY=

# IA primária — Groq (https://console.groq.com)
# Free tier: ~30 req/min, suficiente pra uso pessoal
GROQ_API_KEY=

# IA backup — Google Gemini (opcional, https://aistudio.google.com)
# Free tier: 1500 req/dia
GEMINI_API_KEY=

# Cron Vercel — auth do endpoint /api/cron/check-alerts
# Gerar igual ao ACCESS_KEY
CRON_SECRET=
