PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=

# Token de acesso ao app (32 bytes hex)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_KEY=

# IA primária — Groq
GROQ_API_KEY=

# IA backup — Gemini (opcional)
GEMINI_API_KEY=

# Mercado Livre — App token. Registro grátis em
# https://developers.mercadolivre.com.br/devcenter
# Sem ele, ML retorna 403 (mudança de política 2024). OLX e Web Motor seguem.
ML_ACCESS_TOKEN=

# Cron Vercel
CRON_SECRET=
