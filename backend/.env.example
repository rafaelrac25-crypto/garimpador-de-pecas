PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL=

# Token de acesso ao app (32 bytes hex)
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_KEY=

# IA primária — Groq
GROQ_API_KEY=

# IA backup — Gemini (opcional)
GEMINI_API_KEY=

# Mercado Livre OAuth — App registrada em https://developers.mercadolivre.com.br/devcenter
# ML mudou política em 2024: só OAuth user funciona pra busca.
# Rafa autoriza 1x via /api/ml/start; refresh automático (~6 meses).
# REDIRECT_URI deve estar registrada na App ML (Painel > Editar).
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://garimpador-de-pecas.vercel.app/api/ml-callback
# Fallback legado — se setado, usa esse access_token estático (não rotaciona)
ML_ACCESS_TOKEN=

# Cloudflare Worker proxy — resolve bloqueio anti-bot dos sites BR (OLX/WM)
# em IP de datacenter Vercel. Se vazio, fetch direto (modo dev local).
CLOUDFLARE_PROXY_URL=
CLOUDFLARE_PROXY_KEY=

# Instagram Graph API — pra galeria do @c14docosta na home.
# Conta IG vira Business/Creator → conectar Page FB → developers.facebook.com
# → permissões instagram_basic + pages_show_list → long-lived token (60 dias).
# Sem ele, /api/galeria usa data/galeria-static.json (fallback manual).
IG_ACCESS_TOKEN=

# Notificações de alerta (opcional — sistema sempre grava in-app).
# Email via Resend (https://resend.com) — free 100/dia, sem domínio próprio.
RESEND_API_KEY=
RESEND_FROM=Garimpador <onboarding@resend.dev>

# WhatsApp via CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/) — gratuito.
# Fluxo: enviar "I allow callmebot to send me messages" pro número +34 644 51 95 23
# no WhatsApp → recebe APIKEY pessoal de volta.
CALLMEBOT_APIKEY=

# Cron Vercel
CRON_SECRET=
